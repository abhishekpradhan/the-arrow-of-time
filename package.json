  },
  "bugs": {
    "url": "https://github.com/abhishekpradhan/the-arrow-of-time/issues"
  },
  "funding": "https://buymeacoffee.com/abhishekpradhan",
  "keywords": [
    "film",
    "short-film",
    "generative-art",
    "creative-coding",
