  "prologueLines": [
    { "start": 2, "end": 6.6, "text": "Everything that has ever happened," },
    { "start": 7, "end": 11.6, "text": "and everything that ever will," },
    { "start": 12, "end": 16.8, "text": "begins with a single point." }
  ],
  "epilogueLines": [
    { "start": 317.5, "end": 323, "text": "Between the first light and the last," },
    { "start": 323.4, "end": 329, "text": "there is a brief moment when the universe can look at itself." },
    { "start": 329.4, "end": 333.2, "text": "That moment is now." }
  ],
